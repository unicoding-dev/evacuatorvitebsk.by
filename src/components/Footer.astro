---
import { siteConfig } from '@/data/siteConfig';
import { url } from '@/utils/url';
import ContactWidget from '@/components/ContactWidget.astro';
import { Wrench, MapPin, Phone, Mail, ShieldCheck } from 'lucide-astro';

interface Props {
  showContactWidget?: boolean;
}

const { showContactWidget = false } = Astro.props;
---

{showContactWidget && (
  <div class="w-full">
    <ContactWidget />
  </div>
)}

<footer class="bg-dark-950 text-slate-400 border-t border-slate-800 text-sm">
  <div class="max-w-7xl mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-4 gap-8">
    
    <!-- Col 1: About -->
    <div>
      <div class="flex items-center space-x-3 mb-4">
        <div class="w-8 h-8 rounded-lg bg-primary-500 text-slate-950 flex items-center justify-center font-bold">
          <Wrench class="w-5 h-5" />
        </div>
        <span class="text-lg font-bold text-white">
          ЭВАКУА<span class="text-primary-500">ТОР</span>
        </span>
      </div>
      <p class="text-xs text-slate-400 leading-relaxed mb-4">
        Служба эвакуации автомобилей в Витебске и области. Круглосуточно, 24/7 — легковые, внедорожники, спецтехника, электромобили.
      </p>
      <div class="flex items-center space-x-2 text-xs text-emerald-400 font-medium">
        <ShieldCheck class="w-4 h-4" />
        <span>Работаем 24/7</span>
      </div>
    </div>

    <!-- Col 2: Services -->
    <div>
      <h3 class="text-white font-semibold mb-4 text-sm uppercase tracking-wider">Услуги эвакуации</h3>
      <ul class="space-y-2 text-xs">
        <li><a href={url('/uslugi/evakuaciya-legkovyh-avtomobilej')} class="hover:text-primary-500 transition">Эвакуация легковых авто</a></li>
        <li><a href={url('/uslugi/vytashchit-iz-kjuveta')} class="hover:text-primary-500 transition">Из кювета и грязи</a></li>
        <li><a href={url('/uslugi/evakuaciya-posle-dtp')} class="hover:text-primary-500 transition">Эвакуация после ДТП</a></li>
        <li><a href={url('/uslugi/vyezdnaya-zaryadka-elektromobilej')} class="hover:text-primary-500 transition">Выездная зарядка EV</a></li>
        <li><a href={url('/uslugi/avtotehpomoshch')} class="hover:text-primary-500 transition">Автотехпомощь</a></li>
      </ul>
    </div>

    <!-- Col 3: Brands -->
    <div>
      <h3 class="text-white font-semibold mb-4 text-sm uppercase tracking-wider">Ситуации</h3>
      <ul class="space-y-2 text-xs">
        <li><a href={url('/uslugi/evakuaciya-vnedorozhnikov')} class="hover:text-primary-500 transition">Внедорожники</a></li>
        <li><a href={url('/uslugi/evakuaciya-mikroavtobusov')} class="hover:text-primary-500 transition">Микроавтобусы</a></li>
        <li><a href={url('/uslugi/evakuaciya-spectehniki')} class="hover:text-primary-500 transition">Спецтехника</a></li>
        <li><a href={url('/uslugi/evakuaciya-elektromobilej')} class="hover:text-primary-500 transition">Электромобили</a></li>
        <li><a href={url('/uslugi/evakuator-mezhgorod')} class="hover:text-primary-500 transition">Межгород</a></li>
      </ul>
    </div>

    <!-- Col 4: Contacts -->
    <div>
      <h3 class="text-white font-semibold mb-4 text-sm uppercase tracking-wider">Контакты</h3>
      <ul class="space-y-3 text-xs">
        <li class="flex items-start space-x-2">
          <MapPin class="w-4 h-4 text-primary-500 shrink-0 mt-0.5" />
          <a href={siteConfig.maps.yandex} target="_blank" rel="noopener noreferrer" class="hover:text-primary-500 transition">{siteConfig.address.full}</a>
        </li>
        <li class="flex items-center space-x-2">
          <Phone class="w-4 h-4 text-primary-500 shrink-0" />
          <a href={`tel:${siteConfig.phoneClean}`} class="text-white font-bold hover:text-primary-500 transition">{siteConfig.phonePrimary}</a>
        </li>
        <li class="flex items-center space-x-2">
          <Mail class="w-4 h-4 text-primary-500 shrink-0" />
          <span>{siteConfig.email}</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="bg-dark-900 border-t border-slate-800/80 py-4 text-center text-xs text-slate-500">
    <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row justify-between items-center gap-2">
      <div>© {new Date().getFullYear()} {siteConfig.name}. Все права защищены. Витебск, Беларусь.</div>
      <div class="flex space-x-4">
        <a href={url('/uslugi')} class="hover:text-slate-300 transition">Карта услуг</a>
        <a href={url('/ceny')} class="hover:text-slate-300 transition">Цены</a>
        <a href={url('/otzyvy')} class="hover:text-slate-300 transition">Отзывы</a>
        <a href={url('/novosti')} class="hover:text-slate-300 transition">Новости</a>
        <a href={url('/rayony')} class="hover:text-slate-300 transition">Районы и область</a>
        <a href={url('/faq')} class="hover:text-slate-300 transition">FAQ (Частые вопросы)</a>
        </div>
    </div>
  </div>
</footer>
