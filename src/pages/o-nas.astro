---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { siteConfig } from '@/data/siteConfig';
---

<Layout title="О службе эвакуации — Витебск" description="Служба эвакуации в Витебске: круглосуточная помощь на дорогах, платформы с лебёдкой и подкатами, выездная зарядка электромобилей.">
  <div class="max-w-7xl mx-auto px-4 py-8">
    <Breadcrumbs items={[{ label: 'О нас' }]} />
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white mb-6">О службе <span class="text-primary-500">эвакуации</span> в Витебске</h1>
      <p class="text-slate-300 text-base sm:text-lg leading-relaxed mb-8">Мы — круглосуточная служба эвакуации и помощи на дорогах Витебска и Витебской области. Работаем с легковыми автомобилями, внедорожниками, микроавтобусами, спецтехникой и электромобилями.</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-12">
        <div class="bg-dark-900 p-6 rounded-2xl border border-slate-800 text-center">
          <div class="text-3xl font-black text-primary-500 mb-1">20 мин</div>
          <div class="text-xs text-slate-400">Подача по городу</div>
        </div>
        <div class="bg-dark-900 p-6 rounded-2xl border border-slate-800 text-center">
          <div class="text-3xl font-black text-accent-500 mb-1">24/7</div>
          <div class="text-xs text-slate-400">Круглосуточно, без выходных</div>
        </div>
        <div class="bg-dark-900 p-6 rounded-2xl border border-slate-800 text-center">
          <div class="text-3xl font-black text-emerald-400 mb-1">6 т</div>
          <div class="text-xs text-slate-400">Максимальная масса ТС</div>
        </div>
      </div>
      <h2 class="text-2xl font-bold text-white mb-4">Техника и оснащение</h2>
      <p class="text-slate-300 text-sm leading-relaxed mb-6">Платформы со сдвижным механизмом, лебёдки, подкатные тележки для авто с заблокированными колёсами и рулевым, мягкие стропы для мототехники. Для бездорожья — выезд на лесные и гру
нтовые дороги.</p>
      <h2 class="text-2xl font-bold text-white mb-4">Документы</h2>
      <p class="text-slate-300 text-sm leading-relaxed mb-6">{siteConfig.legalName}, УНП {siteConfig.unp}. Выдаём акты выполненных работ для страховых компаний и бухгалтерии, работаем по безналичному расчёту с юрлицами.</p>
    </div>
  </div>
</Layout>
