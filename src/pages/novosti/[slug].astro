---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import InternalLinks from '@/components/InternalLinks.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/data/siteConfig';
import { url } from '@/utils/url';
import { Phone, Newspaper } from 'lucide-astro';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map(entry => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, metaTitle, description, date, rubric, relatedServices, faq } = entry.data;

const otherPosts = (await getCollection('news'))
  .filter(p => p.slug !== entry.slug)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const rubricLabels: Record<string, string> = {
  news: 'Новости службы',
  guide: 'Полезное',
};

const formatDate = (d: Date) => d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout title={metaTitle || `${title} | Эвакуатор Витебск`} description={description} type="article" publishedDate={date.toISOString().slice(0, 10)} faq={faq} showContactWidget={false}>
  <div class="max-w-7xl mx-auto px-4 py-8">
    <Breadcrumbs items={[{ label: 'Новости', href: '/novosti' }, { label: title }]} />
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <article class="lg:col-span-8">
        <div class="flex items-center space-x-3 text-[11px] mb-4">
          <span class="text-primary-400 font-bold uppercase tracking-wider">{rubricLabels[rubric]}</span>
          <span class="text-slate-500">{formatDate(date)}</span>
        </div>
        <h1 class="text-2xl sm:text-4xl font-extrabold text-white leading-tight mb-6">{title}</h1>
        <div class="prose prose-invert max-w-none prose-headings:font-bold prose-p:text-slate-300 prose-p:leading-relaxed prose-li:text-slate-300 text-sm sm:text-base">
          <Content />
        </div>

        {faq.length > 0 && (
          <section class="mt-10">
            <h2 class="text-lg sm:text-xl font-bold text-white mb-4">Часто задаваемые вопросы</h2>
            <div class="space-y-4">
              {faq.map(item => (
                <details class="bg-dark-900 border border-slate-800/90 hover:border-primary-500/40 rounded-2xl p-5 group cursor-pointer transition">
                  <summary class="font-bold text-white text-sm sm:text-base flex justify-between items-center gap-4 list-none">
                    <span>{item.question}</span>
                    <span class="text-primary-500 transition group-open:rotate-180 shrink-0">▼</span>
                  </summary>
                  <p class="text-xs sm:text-sm text-slate-300 mt-4 leading-relaxed border-t border-slate-800/80 pt-3">{item.answer}</p>
                </details>
              ))}
            </div>
          </section>
        )}
      </article>

      <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-24 self-start">
        <div class="bg-dark-900 p-6 rounded-2xl border border-slate-800">
          <h3 class="text-base font-bold text-white mb-2">Нужна помощь на дороге?</h3>
          <p class="text-xs text-slate-400 mb-4 leading-relaxed">Диспетчер на связи круглосуточно — назовём цену и время подачи сразу.</p>
          <a href={`tel:${siteConfig.phoneClean}`} class="block w-full bg-primary-500 hover:bg-primary-400 text-slate-950 font-bold py-3 text-center rounded-xl text-sm transition mb-3">{siteConfig.phonePrimary}</a>
          <div class="text-[11px] text-slate-500 text-center mb-4">{siteConfig.workingHours}. Витебск и область.</div>
          <div class="flex justify-center space-x-2 text-xs font-medium border-t border-slate-800 pt-4">
            <a href={siteConfig.social.viber} class="px-3 py-1.5 rounded-lg bg-purple-950 text-purple-300 border border-purple-800/50 hover:bg-purple-900 transition">Viber</a>
            <a href={siteConfig.social.telegram} class="px-3 py-1.5 rounded-lg bg-sky-950 text-sky-300 border border-sky-800/50 hover:bg-sky-900 transition">Telegram</a>
            <a href={siteConfig.social.whatsapp} class="px-3 py-1.5 rounded-lg bg-emerald-950 text-emerald-300 border border-emerald-800/50 hover:bg-emerald-900 transition">WhatsApp</a>
          </div>
        </div>

        <div class="bg-dark-900 p-6 rounded-2xl border border-slate-800">
          <h3 class="text-sm font-bold text-white mb-4 flex items-center space-x-2">
            <Newspaper class="w-4 h-4 text-primary-500" />
            <span>Ещё из новостей</span>
          </h3>
          <div class="space-y-4">
            {otherPosts.map(p => (
              <a href={url(`/novosti/${p.slug}`)} class="block group">
                <span class="text-[10px] text-slate-500 block mb-1">{formatDate(p.data.date)}</span>
                <span class="text-xs font-semibold text-slate-200 group-hover:text-primary-400 transition leading-snug block">{p.data.title}</span>
              </a>
            ))}
          </div>
          <a href={url('/novosti')} class="block text-xs font-bold text-primary-500 hover:text-primary-400 mt-4 pt-3 border-t border-slate-800">Все материалы →</a>
        </div>
      </aside>
    </div>

    <InternalLinks relatedSlugs={relatedServices} />
  </div>
</Layout>
