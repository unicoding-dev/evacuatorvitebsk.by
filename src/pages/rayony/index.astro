---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/data/siteConfig';
import { url } from '@/utils/url';
import { MapPin, Phone, Clock } from 'lucide-astro';

const geoPages = (await getCollection('geo')).sort((a, b) => a.data.distanceKm - b.data.distanceKm);

const villages = [
  'Руба', 'Новка', 'Зароново', 'Октябрьский', 'Вымно', 'Мазолово', 'Бабиновичи',
  'Богушевск', 'Мошканы', 'Улла', 'Сураж', 'Шапечино', 'Сосновка', 'Островно',
  'Вороны', 'Оболь', 'Бычиха', 'Добромысли',
];

const mapWidgetUrl = `https://yandex.ru/map-widget/v1/?ll=${siteConfig.address.longitude}%2C${siteConfig.address.latitude}&z=8`;

const faqList = [
  { question: 'Выезжаете ли в мелкие посёлки и деревни?', answer: 'Да, работаем по всему Витебскому району и ближним районам области — не только райцентры. Чем точнее укажете место (геометка, ориентиры), тем быстрее подача.' },
  { question: 'Сколько ждать эвакуатор в район?', answer: 'Ближние райцентры — 40–80 минут от выезда из Витебска. Точное время называем при вызове: зависит от расстояния, загрузки экипажей и состояния дорог к вам.' },
  { question: 'Как считается цена за городом?', answer: 'Тариф города плюс километраж — от 1 BYN/км. Сумму фиксируем до выезда, на месте она не меняется.' },
  { question: 'Вытащите из кювета или с грунтовки в деревне?', answer: 'Да, есть лебёдка и подкатные тележки — это частые вызовы по районам. Опишите состояние подъезда диспетчеру.' },
  { question: 'Возите межгород из районов?', answer: 'Да: из любого пункта области в Витебск, Минск, Полоцк, Смоленск, Москва. Погрузка + километраж по фиксированному тарифу.' },
];
---

<Layout showContactWidget={true} title="Эвакуатор по Витебскому району и области — выезд в райцентры | Эвакуатор Витебск" description="Эвакуатор по Витебскому району и области: Городок, Лиозно, Шумилино, Бешенковичи, Сенно, Дубровно и посёлки. Подача 40–80 минут, тариф + км. Круглосуточно." faq={faqList}>
  <div class="max-w-7xl mx-auto px-4 py-8">
    <Breadcrumbs items={[{ label: 'Районы и область' }]} />
    <h1 class="text-3xl sm:text-4xl font-extrabold text-white mb-4">Эвакуатор по Витебскому району и области</h1>
    <p class="text-slate-300 text-sm sm:text-base mb-8 max-w-3xl">
      Выезжаем за черту Витебска: ближние райцентры — подача 40–80 минут, посёлки и деревни Витебского района, межгород по РБ и РФ. Стоимость — тариф города + километраж ({siteConfig.kmRate}), сумма фиксируется до выезда.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">
      {geoPages.map(g => (
        <a href={url(`/rayony/${g.slug}`)} class="bg-dark-900 p-6 rounded-2xl border border-slate-800 hover:border-primary-500/50 transition group">
          <div class="flex items-start justify-between gap-3 mb-3">
            <div class="w-10 h-10 rounded-xl bg-primary-500/20 text-primary-500 flex items-center justify-center shrink-0"><MapPin class="w-5 h-5" /></div>
            <span class="text-[11px] text-slate-400">{g.data.distanceKm} км · {g.data.driveTime}</span>
          </div>
          <h2 class="text-base font-bold text-white group-hover:text-primary-400 transition mb-1.5">{g.data.title}</h2>
          <p class="text-xs text-slate-400 leading-relaxed mb-3">{g.data.direction}</p>
          <span class="text-xs font-bold text-emerald-400">{g.data.priceNote}</span>
        </a>
      ))}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-12">
      <div class="lg:col-span-5">
        <h2 class="text-lg sm:text-xl font-bold text-white mb-4">Посёлки Витебского района</h2>
        <p class="text-xs sm:text-sm text-slate-400 leading-relaxed mb-4">
          По мелким пунктам работаем без отдельных страниц — но выезжаем везде. Если вашего посёлка нет в списке — всё равно звоните.
        </p>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed bg-dark-900 p-5 rounded-2xl border border-slate-800">
          {villages.join(' · ')}
        </p>
        <div class="mt-6 bg-dark-900 p-5 rounded-2xl border border-slate-800">
          <div class="flex items-center space-x-2 text-xs text-slate-300 mb-2">
            <Clock class="w-4 h-4 text-emerald-400" />
            <span>Межгород: Минск, Полоцк, Смоленск, Москва — <a href={url('/uslugi/evakuator-mezhgorod')} class="text-primary-400 hover:text-primary-300 font-bold">тариф за км</a></span>
          </div>
          <div class="flex items-center space-x-2 text-xs text-slate-300">
            <Phone class="w-4 h-4 text-primary-500" />
            <span>Диспетчер 24/7: <a href={`tel:${siteConfig.phoneClean}`} class="text-white font-bold">{siteConfig.phonePrimary}</a></span>
          </div>
        </div>
      </div>
      <div class="lg:col-span-7 bg-dark-900 rounded-3xl overflow-hidden border border-slate-800 min-h-[380px] relative shadow-xl">
        <iframe title="Зона выезда эвакуатора — Витебск и область" src={mapWidgetUrl} class="w-full h-full min-h-[380px] border-0" allowfullscreen="true"></iframe>
      </div>
    </div>

    <section>
      <h2 class="text-lg sm:text-xl font-bold text-white mb-4">Частые вопросы про выезд в районы</h2>
      <div class="space-y-4">
        {faqList.map(item => (
          <details class="bg-dark-900 border border-slate-800/90 hover:border-primary-500/40 rounded-2xl p-5 group cursor-pointer transition">
            <summary class="font-bold text-white text-sm sm:text-base flex justify-between items-center gap-4 list-none">
              <span>{item.question}</span>
              <span class="text-primary-500 transition group-open:rotate-180 shrink-0">▼</span>
            </summary>
            <p class="text-xs sm:text-sm text-slate-300 mt-4 leading-relaxed border-t border-slate-800/80 pt-3">{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Layout>
