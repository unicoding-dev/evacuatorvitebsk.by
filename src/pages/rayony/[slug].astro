---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import InternalLinks from '@/components/InternalLinks.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '@/data/siteConfig';
import { MapPin, Clock, Tag, Phone } from 'lucide-astro';

export async function getStaticPaths() {
  const geoPages = await getCollection('geo');
  return geoPages.map(entry => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, metaTitle, description, distanceKm, driveTime, direction, priceNote, relatedServices, faq } = entry.data;
---

<Layout title={metaTitle || `${title} — подача из Витебска 24/7 | Эвакуатор Витебск`} description={description} faq={faq} showContactWidget={false}>
  <div class="max-w-7xl mx-auto px-4 py-8">
    <Breadcrumbs items={[{ label: 'Районы и область', href: '/rayony' }, { label: entry.data.town }]} />
    <div class="bg-dark-900 rounded-3xl border border-slate-800 p-6 sm:p-10 mb-12">
      <div class="inline-flex items-center space-x-2 bg-primary-500/10 border border-primary-500/30 text-primary-400 font-semibold text-xs px-3 py-1 rounded-md mb-4 uppercase tracking-wider">
        <MapPin class="w-3.5 h-3.5" />
        <span>~{distanceKm} км от Витебска · {direction}</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-white leading-tight mb-4">{title}</h1>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6 max-w-2xl">{description}</p>
      <div class="flex flex-wrap gap-4 mb-6 text-xs text-slate-200">
        <div class="flex items-center space-x-2 bg-dark-950 px-3.5 py-2 rounded-xl border border-slate-800">
          <Clock class="w-4 h-4 text-accent-500" /><span>Подача: <strong class="text-white font-bold">{driveTime}</strong></span>
        </div>
        <div class="flex items-center space-x-2 bg-dark-950 px-3.5 py-2 rounded-xl border border-slate-800">
          <Tag class="w-4 h-4 text-emerald-400" /><span>Ориентир: <strong class="text-emerald-400 font-bold">{priceNote}</strong></span>
        </div>
      </div>
      <a href={`tel:${siteConfig.phoneClean}`} class="inline-flex items-center space-x-2 bg-gradient-to-r from-primary-600 to-primary-500 hover:from-primary-500 hover:to-accent-500 text-slate-950 font-bold px-6 py-3.5 rounded-xl text-xs uppercase tracking-wider shadow-lg shadow-primary-600/20 transition">
        <Phone class="w-4 h-4" /><span>Вызвать эвакуатор</span>
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-8 prose prose-invert max-w-none prose-headings:font-bold prose-p:text-slate-300 prose-p:leading-relaxed prose-li:text-slate-300 text-sm sm:text-base">
        <Content />
      </div>
      <aside class="lg:col-span-4 space-y-6">
        <div class="bg-dark-900 p-6 rounded-2xl border border-slate-800 sticky top-24">
          <h3 class="text-base font-bold text-white mb-2">Нужен эвакуатор прямо сейчас?</h3>
          <p class="text-xs text-slate-400 mb-4 leading-relaxed">Сообщите марку авто, точное место и состояние — назовём цену и время подачи сразу.</p>
          <a href={`tel:${siteConfig.phoneClean}`} class="block w-full bg-primary-500 hover:bg-primary-400 text-slate-950 font-bold py-3 text-center rounded-xl text-sm transition mb-3">{siteConfig.phonePrimary}</a>
          <div class="text-[11px] text-slate-500 text-center">{siteConfig.workingHours}. Витебск и область.</div>
        </div>
      </aside>
    </div>

    {faq.length > 0 && (
      <section class="mt-12 max-w-3xl">
        <h2 class="text-lg sm:text-xl font-bold text-white mb-4">Частые вопросы</h2>
        <div class="space-y-4">
          {faq.map(item => (
            <details class="bg-dark-900 border border-slate-800/90 hover:border-primary-500/40 rounded-2xl p-5 group cursor-pointer transition">
              <summary class="font-bold text-white text-sm sm:text-base flex justify-between items-center gap-4 list-none">
                <span>{item.question}</span>
                <span class="text-primary-500 transition group-open:rotate-180 shrink-0">▼</span>
              </summary>
              <p class="text-xs sm:text-sm text-slate-300 mt-4 leading-relaxed border-t border-slate-800/80 pt-3">{item.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <InternalLinks relatedSlugs={relatedServices} />
  </div>
</Layout>
