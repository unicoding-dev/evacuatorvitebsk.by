---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { reviews } from '@/components/ReviewsSlider.astro';
import { siteConfig } from '@/data/siteConfig';
import { Star, Quote, Phone, MapPin, MessageSquare, ShieldCheck } from 'lucide-astro';

const avgRating = reviews.length > 0
  ? (reviews.reduce((sum, r) => sum + r.rating, 0) / reviews.length).toFixed(1).replace('.', ',')
  : null;

const faqList = [
  { question: 'Почему на сайте пока мало отзывов?', answer: 'Сайт новый — публикуем только реальные отзывы после выполненных заказов и с карт, без выдуманных. Подробнее о работе — на странице «О сервисе».' },
  { question: 'Как оставить отзыв?', answer: 'Проще всего — на нашей карточке в Яндекс.Картах или Google. Можно написать в мессенджер или рассказать диспетчеру по телефону — перенесём на сайт с вашего согласия.' },
  { question: 'Почему мой отзыв ещё не опубликован?', answer: 'Каждый отзыв проходит модерацию перед публикацией — проверяем, что он от реального клиента. Обычно это занимает до пары дней.' },
];
---

<Layout showContactWidget={true} title="Отзывы о службе эвакуации — Витебск | Эвакуатор Витебск" description="Отзывы клиентов о работе эвакуатора в Витебске: скорость подачи, цены, выездная зарядка электромобилей. Оставить отзыв — на Яндекс.Картах или в мессенджере." faq={faqList}>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <Breadcrumbs items={[{ label: 'Отзывы' }]} />
    <h1 class="text-3xl sm:text-4xl font-extrabold text-white mb-4">Отзывы о службе эвакуации</h1>

    {reviews.length === 0 ? (
      <p class="text-slate-300 text-sm sm:text-base mb-8">
        Мы только запустили сайт, поэтому отзывов здесь пока нет. Публикуем только реальные отзывы — если вы уже пользовались нашим эвакуатором, ваш отзыв будет первым.
      </p>
    ) : (
      <div class="flex items-center space-x-4 mb-8 bg-dark-900 p-5 rounded-2xl border border-slate-800">
        <div class="flex items-center space-x-1">
          {Array.from({ length: 5 }).map((_, i) => (
            <Star class={`w-6 h-6 ${i < Math.round(reviews.reduce((s, r) => s + r.rating, 0) / reviews.length) ? 'text-accent-500 fill-accent-500' : 'text-slate-700'}`} />
          ))}
        </div>
        <div>
          <span class="text-2xl font-extrabold text-white">{avgRating}</span>
          <span class="text-xs text-slate-400 block">из 5 · отзывов: {reviews.length}</span>
        </div>
      </div>
    )}

    {reviews.length > 0 && (
      <div class="space-y-6 mb-10">
        {reviews.map(r => (
          <div class="bg-dark-900 p-6 rounded-2xl border border-slate-800 flex flex-col">
            <Quote class="w-6 h-6 text-primary-500 mb-3" />
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed flex-1 mb-4">{r.text}</p>
            <div class="flex items-center justify-between pt-3 border-t border-slate-800">
              <div>
                <span class="text-sm font-bold text-white block">{r.name}</span>
                {r.service && <span class="text-[11px] text-slate-400">{r.service}</span>}
                {r.date && <span class="text-[11px] text-slate-500 block">{r.date}</span>}
              </div>
              <div class="flex space-x-0.5">{Array.from({ length: r.rating }).map(() => <Star class="w-3.5 h-3.5 text-accent-500 fill-accent-500" />)}</div>
            </div>
          </div>
        ))}
      </div>
    )}

    <section class="mb-10">
      <h2 class="text-lg sm:text-xl font-bold text-white mb-4">Оставить отзыв</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <a href={siteConfig.maps.yandex} target="_blank" rel="noopener noreferrer" class="bg-dark-900 p-5 rounded-2xl border border-slate-800 hover:border-primary-500/50 transition group">
          <MapPin class="w-6 h-6 text-primary-500 mb-3" />
          <h3 class="text-sm font-bold text-white group-hover:text-primary-400 transition mb-1.5">На картах</h3>
          <p class="text-xs text-slate-400 leading-relaxed">Оцените нас на карточке в Яндекс.Картах — это помогает другим водителям</p>
        </a>
        <a href={siteConfig.social.telegram} target="_blank" rel="noopener noreferrer" class="bg-dark-900 p-5 rounded-2xl border border-slate-800 hover:border-primary-500/50 transition group">
          <MessageSquare class="w-6 h-6 text-sky-400 mb-3" />
          <h3 class="text-sm font-bold text-white group-hover:text-primary-400 transition mb-1.5">В мессенджере</h3>
          <p class="text-xs text-slate-400 leading-relaxed">Напишите в Telegram, Viber или WhatsApp — опубликуем с вашего согласия</p>
        </a>
        <a href={`tel:${siteConfig.phoneClean}`} class="bg-dark-900 p-5 rounded-2xl border border-slate-800 hover:border-primary-500/50 transition group">
          <Phone class="w-6 h-6 text-emerald-400 mb-3" />
          <h3 class="text-sm font-bold text-white group-hover:text-primary-400 transition mb-1.5">Диспетчеру</h3>
          <p class="text-xs text-slate-400 leading-relaxed">Расскажите по телефону — {siteConfig.phonePrimary}</p>
        </a>
      </div>
    </section>

    <div class="flex items-start space-x-3 bg-dark-900 p-5 rounded-2xl border border-slate-800 mb-10">
      <ShieldCheck class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" />
      <p class="text-xs text-slate-400 leading-relaxed">
        Публикуем только реальные отзывы после модерации. Если что-то пошло не так — напишите нам напрямую, разберёмся быстрее, чем через отзыв.
      </p>
    </div>

    <section>
      <h2 class="text-lg sm:text-xl font-bold text-white mb-4">Вопросы про отзывы</h2>
      <div class="space-y-4">
        {faqList.map(item => (
          <details class="bg-dark-900 border border-slate-800/90 hover:border-primary-500/40 rounded-2xl p-5 group cursor-pointer transition">
            <summary class="font-bold text-white text-sm sm:text-base flex justify-between items-center gap-4 list-none">
              <span>{item.question}</span>
              <span class="text-primary-500 transition group-open:rotate-180 shrink-0">▼</span>
            </summary>
            <p class="text-xs sm:text-sm text-slate-300 mt-4 leading-relaxed border-t border-slate-800/80 pt-3">{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Layout>
