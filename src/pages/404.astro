---
import Layout from '@/layouts/Layout.astro';
import { siteConfig } from '@/data/siteConfig';
import { url } from '@/utils/url';
import { Truck, Phone, Home } from 'lucide-astro';

const popularServices = [
  { label: 'Эвакуация легковых авто', href: url('/uslugi/evakuaciya-legkovyh-avtomobilej') },
  { label: 'Вытащить из кювета', href: url('/uslugi/vytashchit-iz-kjuveta') },
  { label: 'Эвакуация после ДТП', href: url('/uslugi/evakuaciya-posle-dtp') },
  { label: 'Выездная зарядка электромобилей', href: url('/uslugi/vyezdnaya-zaryadka-elektromobilej') },
  { label: 'Автотехпомощь', href: url('/uslugi/avtotehpomoshch') },
];
---

<Layout
  title="Страница не найдена (404) | Эвакуатор Витебск"
  description="Запрашиваемая страница не найдена. Вызвать эвакуатор в Витебске круглосуточно или перейти в каталог услуг."
>
  <div class="max-w-3xl mx-auto px-4 py-20 text-center">
    <div class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-primary-500/10 border border-primary-500/30 text-primary-500 mb-8">
      <Truck class="w-10 h-10" />
    </div>

    <div class="text-7xl sm:text-8xl font-black text-primary-500 mb-4 leading-none">404</div>
    <h1 class="text-2xl sm:text-3xl font-extrabold text-white mb-4">
      Страница не найдена
    </h1>
    <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-10 max-w-xl mx-auto">
      Такой страницы нет или она переехала. Вернитесь на главную, выберите услугу или позвоните — поможем круглосуточно.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
      <a href={url('/')} class="inline-flex items-center space-x-2 bg-primary-500 hover:bg-primary-400 text-slate-950 font-bold px-6 py-3 rounded-xl text-sm transition">
        <Home class="w-4 h-4" />
        <span>На главную</span>
      </a>
      <a href={`tel:${siteConfig.phoneClean}`} class="inline-flex items-center space-x-2 bg-slate-800 hover:bg-slate-700 text-white font-bold px-6 py-3 rounded-xl text-sm border border-slate-700 transition">
        <Phone class="w-4 h-4" />
        <span>{siteConfig.phonePrimary}</span>
      </a>
    </div>

    <div class="text-left bg-dark-900 border border-slate-800 rounded-2xl p-6">
      <h2 class="text-sm font-bold text-white mb-4">Популярные услуги</h2>
      <ul class="space-y-2 text-sm">
        {popularServices.map(s => (
          <li><a href={s.href} class="text-primary-400 hover:underline">{s.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</Layout>
