---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { siteConfig } from '@/data/siteConfig';

const faqItems = [
  { category: 'price', question: 'Сколько стоит эвакуатор в Витебске?', answer: 'Эвакуация легкового авто — от 60 BYN по городу, внедорожник — от 80, микроавтобус — от 90, спецтехника — от 90. За городом добавляется тариф за километраж. Точную стоимость называем до выезда.' },
  { category: 'price', question: 'Дороже ли ночью и зимой?', answer: 'Ночной вызов (20:00–08:00) — доплата ~20 руб., зимние условия и сложная погрузка — по тарифу. Доплаты озвучиваем до выезда, без сюрпризов на месте.' },
  { category: 'price', question: 'Как оплатить: наличные, безнал, юрлицо?', answer: 'Наличные и карта на месте, безналичный расчёт для юрлиц с полным пакетом документов. Выдаём акт для страховой.' },
  { category: 'price', question: 'Что если машину не нужно эвакуировать после приезда?', answer: 'Если эвакуатор приехал, а вы отказались — оплачивается только ложный вызов по тарифу. Если проблему решили на месте (прикурить, колесо) — платится за автопомощь.' },
  { category: 'time', question: 'Как быстро приедет эвакуатор?', answer: 'По Витебску — от 20 минут. В ближние районы области — 30–90 минут в зависимости от расстояния. Точное время говорим при вызове.' },
  { category: 'time', question: 'Работаете ночью, в выходные и праздники?', answer: 'Да, диспетчер и эвакуаторы работают круглосуточно 24/7, без выходных и праздников.' },
  { category: 'time', question: 'Что сообщить диспетчеру при вызове?', answer: 'Марку и модель авто, адрес или геометку, состояние (крутятся ли колёса, работает ли рулевое, есть ли повреждения), тип КПП и адрес доставки.' },
  { category: 'vehicle', question: 'Погрузите машину с заблокированными колёсами?', answer: 'Да, используем подкатные тележки — подходят для авто с клином суппорта, электроручником, АКПП в «парке» и полным приводом.' },
  { category: 'vehicle', question: 'Эвакуируете грузовые авто и спецтехнику?', answer: 'Да, работаем с фургонами и лёгкими грузовиками до 6 тонн, тракторами, погрузчиками и другой техникой. Сообщите массу и габариты диспетчеру.' },
  { category: 'vehicle', question: 'Можно ли буксировать полный привод?', answer: 'Полный привод грузим только на платформу либо с двумя подкатами — буксировка с вывешенной осью портит трансмиссию. Сообщите тип привода при вызове.' },
  { category: 'ev', question: 'Разрядился электромобиль — что дешевле: эвакуатор или зарядка?', answer: 'Если авто исправен — выездная зарядка обычно дешевле и быстрее: привозим мобильную зарядку на место. Если неисправность — эвакуируем на платформе.' },
  { category: 'ev', question: 'Сколько пути даёт выездная зарядка?', answer: 'Зарядка до ~10 кВт ≈ 50 км пути — достаточно доехать до стационарной станции или дома.' },
  { category: 'geo', question: 'Выезжаете в районы области?', answer: 'Да, ближний радиус: Городок, Лиозно, Шумилино, Бешенковичи, Сенно, Дубровно и посёлки Витебского района. Также межгород — Минск, Полоцк, Смоленск, Москва.' },
  { category: 'geo', question: 'Эвакуатор нужен на межгород — как считается?', answer: 'Погрузка + километраж по фиксированному тарифу за км. Сумму фиксируем до выезда.' },
  { category: 'docs', question: 'Выдаёте документы для страховой?', answer: 'Да, акт выполненных работ с датой, адресом и стоимостью — принимается страховыми компаниями и бухгалтерией предприятий.' },
  { category: 'docs', question: 'Работаете с юрлицами и автопарками?', answer: 'Да, безналичный расчёт, договор, акты. Можно организовать регулярное обслуживание автопарка.' },
];

const catLabels: Record<string, string> = {
  price: 'Цена и оплата', time: 'Подача и время', vehicle: 'Погрузка и транспорт',
  ev: 'Электромобили', geo: 'Районы и межгород', docs: 'Документы',
};
---

<Layout showContactWidget={true} title="FAQ — частые вопросы про эвакуатор в Витебске" description="Ответы на частые вопросы: цены на эвакуатор в Витебске, время подачи, погрузка сложных авто, электромобили, документы для страховой и юрлиц." faq={faqItems.map(i => ({ question: i.question, answer: i.answer }))}>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <Breadcrumbs items={[{ label: 'FAQ' }]} />
    <h1 class="text-3xl sm:text-4xl font-extrabold text-white mb-4">Частые вопросы про эвакуатор</h1>
    <p class="text-slate-300 text-sm sm:text-base mb-8">Цены, время подачи, погрузка сложных автомобилей, электромобили и документы. Не нашли ответ — звоните: <a href={`tel:${siteConfig.phoneClean}`} class="text-primary-400 font-bold">{siteConfig.phonePrimary}</a></p>
    <div class="space-y-4">
      {faqItems.map(item => (
        <details class="bg-dark-900 border border-slate-800/90 hover:border-primary-500/40 rounded-2xl p-5 group cursor-pointer transition">
          <summary class="font-bold text-white text-sm sm:text-base flex justify-between items-center gap-4 list-none">
            <span>{item.question}</span>
            <span class="text-primary-500 transition group-open:rotate-180 shrink-0">▼</span>
          </summary>
          <p class="text-xs sm:text-sm text-slate-300 mt-4 leading-relaxed border-t border-slate-800/80 pt-3">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</Layout>
